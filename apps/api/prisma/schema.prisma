// Prisma Schema for ST-Solutions Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum AccountType {
  ADMIN
  SUB_ADMIN
  MANAGER
  MEMBER
  CLIENT
}

model User {
  id           String      @id @default(uuid())
  email        String?     @unique
  passwordHash String
  accountType  AccountType @default(MEMBER)
  status       UserStatus  @default(PENDING)
  roleId       String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  role      Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  profile   UserProfile?
  sessions  Session[]
  auditLogs AuditLog[]

  reviewedApplications MemberApplication[]  @relation("ReviewedApplications")
  verificationsDone    MemberVerification[] @relation("VerifiedByUsers")
  memberProfiles       MemberProfile[]      @relation("UserMemberProfiles")

  clientAccount    Client?         @relation("ClientAccount")
  createdProjects  Project[]       @relation("CreatedProjects")
  managedProjects  Project[]       @relation("ManagedProjects")
  assignedProjects Project[]       @relation("AssignedProjects")
  projectUpdates   ProjectUpdate[] @relation("ProjectUpdates")
  approvedPayments Payment[]       @relation("ApprovedPayments")

  @@index([email])
  @@index([status])
  @@index([accountType])
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  MORE_INFORMATION_REQUIRED
}

enum VerificationStatus {
  NOT_VERIFIED
  VERIFIED
  FAILED
}

model MemberApplication {
  id String @id @default(uuid())

  // Personal Information
  fullName       String
  fatherName     String
  email          String
  phoneNumber    String
  whatsappNumber String
  country        String
  city           String
  address        String

  // Identification Information
  cnicNumber     String?
  cnicIssueDate  DateTime?
  cnicExpiryDate DateTime?

  // Professional Information
  currentProfession    String?
  currentQualification String?
  skillsDescription    String?

  // Social Profiles
  linkedinUrl  String?
  instagramUrl String?
  facebookUrl  String?
  tiktokUrl    String?
  githubUrl    String?

  // Application Information
  heardAboutSTSolutions String
  joiningPurpose        String
  profileImageUrl       String?

  // Status
  applicationStatus  ApplicationStatus  @default(PENDING)
  verificationStatus VerificationStatus @default(NOT_VERIFIED)

  // Review Information
  reviewedById    String?
  reviewNotes     String?
  rejectionReason String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  reviewedBy    User?                @relation("ReviewedApplications", fields: [reviewedById], references: [id], onDelete: SetNull)
  answers       ApplicationAnswer[]
  verifications MemberVerification[]
  profiles      MemberProfile[]

  @@index([email])
  @@index([phoneNumber])
  @@index([applicationStatus])
  @@index([createdAt])
}

model ApplicationQuestion {
  id          String   @id @default(uuid())
  question    String
  orderNumber Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  answers ApplicationAnswer[]
}

model ApplicationAnswer {
  id            String   @id @default(uuid())
  applicationId String
  questionId    String
  answer        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application MemberApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question    ApplicationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([applicationId, questionId])
  @@index([applicationId])
  @@index([questionId])
}

model MemberVerification {
  id                 String             @id @default(uuid())
  applicationId      String
  verificationStatus VerificationStatus @default(NOT_VERIFIED)
  verifiedById       String?
  verificationNotes  String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  application MemberApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  verifiedBy  User?             @relation("VerifiedByUsers", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([verificationStatus])
}

model MemberProfile {
  id            String    @id @default(uuid())
  applicationId String
  userId        String?
  memberRank    String?
  joinedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  application MemberApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User?             @relation("UserMemberProfiles", fields: [userId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([userId])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  fullName     String?
  profileImage String?
  phoneNumber  String?
  country      String?
  city         String?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  description String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

enum ClientStatus {
  LEAD
  CONTACTED
  CONFIRMED
  ACTIVE
  COMPLETED
  INACTIVE
}

enum ProjectStatus {
  PENDING
  DISCUSSION
  CONFIRMED
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

model Client {
  id                  String       @id @default(uuid())
  userId              String?      @unique
  companyName         String?
  fullName            String
  email               String
  phoneNumber         String
  whatsappNumber      String?
  country             String?
  city                String?
  address             String?
  profileImage        String?
  businessType        String?
  businessDescription String?
  clientStatus        ClientStatus @default(LEAD)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user     User?     @relation("ClientAccount", fields: [userId], references: [id], onDelete: SetNull)
  projects Project[]
  payments Payment[]

  @@index([email])
  @@index([phoneNumber])
  @@index([clientStatus])
}

model Project {
  id                     String        @id @default(uuid())
  clientId               String
  createdById            String
  assignedManagerId      String?
  assignedMemberId       String?
  title                  String
  description            String?
  category               String?
  budget                 Float?
  projectStatus          ProjectStatus @default(PENDING)
  startDate              DateTime?
  expectedCompletionDate DateTime?
  completedDate          DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  client    Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User            @relation("CreatedProjects", fields: [createdById], references: [id], onDelete: Restrict)
  manager   User?           @relation("ManagedProjects", fields: [assignedManagerId], references: [id], onDelete: SetNull)
  member    User?           @relation("AssignedProjects", fields: [assignedMemberId], references: [id], onDelete: SetNull)
  updates   ProjectUpdate[]
  payments  Payment[]

  @@index([clientId])
  @@index([projectStatus])
  @@index([createdAt])
}

model ProjectUpdate {
  id                 String   @id @default(uuid())
  projectId          String
  createdById        String
  title              String
  description        String?
  progressPercentage Int      @default(0)
  createdAt          DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("ProjectUpdates", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([createdAt])
}

model Payment {
  id                   String        @id @default(uuid())
  clientId             String
  projectId            String?
  amount               Float
  currency             String        @default("USD")
  paymentMethod        String?
  transactionReference String?
  paymentStatus        PaymentStatus @default(PENDING)
  approvedById         String?
  approvalNotes        String?
  submittedAt          DateTime?
  approvedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  approvedBy User?    @relation("ApprovedPayments", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([projectId])
  @@index([paymentStatus])
}

model ClientRequest {
  id             String   @id @default(uuid())
  fullName       String
  email          String
  phoneNumber    String?
  whatsappNumber String?
  message        String
  country        String?
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}
