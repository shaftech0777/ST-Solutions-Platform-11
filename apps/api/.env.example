# ST-Solutions API Environment Variables Example

# Application Runtime Settings
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL / Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/st_solutions?schema=public"

# Authentication & JWT Security
JWT_SECRET=default-development-jwt-secret-key-32charsmin
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Root Administrator & Sub-Administrator Initial Credentials
ADMIN_EMAIL=admin@st-solutions.com
ADMIN_PASSWORD=Admin@123456
SUB_ADMIN_EMAIL=subadmin@st-solutions.com
SUB_ADMIN_PASSWORD=SubAdmin@123456

# Security Policies
CORS_ORIGIN="*"

# Logging System Configuration (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info

# AI Integrations (Optional)
AI_PROVIDER=gemini
AI_API_KEY=your-gemini-api-key-here

# Email / SMTP Transport Configuration (Optional)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
