{
  "name": "st-solutions",
  "version": "1.0.0",
  "private": true,
  "description": "Official ST-Solutions Platform",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "test": "npm run test --workspace=apps/api",
    "format": "prettier --write .",
    "check": "npm run build && npm run lint"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "^5.22.0",
    "bcrypt": "6.0.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express-rate-limit": "8.6.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "lucide-react": "^0.546.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcrypt": "6.0.0",
    "@types/cors": "2.8.19",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "nodemon": "3.1.14",
    "prettier": "^3.5.3",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.1.14",
    "tsx": "4.23.12",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
